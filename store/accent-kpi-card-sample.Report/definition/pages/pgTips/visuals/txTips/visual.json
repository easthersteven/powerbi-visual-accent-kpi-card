{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "txTips",
  "position": {
    "x": 40,
    "y": 96,
    "z": 0,
    "width": 1200,
    "height": 520,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Formatting the value",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold",
                      "color": "#1F908C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "valueFormat accepts \"currency\", \"percent\" (one decimal), \"decimal1\", or empty for a whole number with thousands grouping. For currency, set currencyCode to an ISO 4217 code such as AUD, GBP or USD - an unrecognised code falls back to a plain number rather than showing the wrong symbol.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Decimal places",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold",
                      "color": "#1F908C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Set decimals (0-4) to tailor precision in any format - two decimal currency, a whole number percentage. Leave it unset and each format keeps its own default.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Compact notation",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold",
                      "color": "#1F908C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Turn on compact for headline figures: 1,284,000 becomes 1.28M and 52,000 becomes 52K. Small numbers are left alone, so 37 stays 37.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Percent values versus percentage change",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold",
                      "color": "#1F908C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "A percent card reports its delta in percentage points (\"1.1pp\") because a rate moving from 97.5% to 96.4% has fallen 1.1 points, not 1.1 percent. When the value is an absolute quantity and you want a proportional change, set deltaFormat to percentChange.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Empty states",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold",
                      "color": "#1F908C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Set the \"No data\" default to 0 for counts and to n/a for things that genuinely have no value yet. Any non-numeric default is shown as typed.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Avoid",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold",
                      "color": "#1F908C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Binding a text measure to Delta if you want colour - non-numeric deltas render as a neutral badge by design.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#333333"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
