{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "txNotes",
  "position": {
    "x": 40,
    "y": 580,
    "z": 0,
    "width": 1200,
    "height": 130,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What to look at",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold",
                      "color": "#1F908C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Currency and compact notation - revenue is 1,284,000 rendered as $1.28M. Symbol placement and separators follow the host locale; the ISO code is a Format pane setting.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "A delta that reads differently from the value - the revenue card shows a percentage change on a currency value. Format pane > Delta badge > Delta format > Percent change (%).",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Direction aware colour - open tickets is a 'down is good' metric, so a fall of 12 shows green, while on-time delivery slipping 1.1pp shows red.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Percentage points - a change in a rate is reported in pp, not percent, because that is what the change actually means.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Value when empty - the last card is bound to a measure returning BLANK(). Instead of an empty card it shows the configured default, formatted like a real value.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Cross-filtering - the bottom-left card binds Month to the Cross-filter field bucket, so it labels itself with the month and clicking it filters the column chart beside it. Click again to clear.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#333333"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
