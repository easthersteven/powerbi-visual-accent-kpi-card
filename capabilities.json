    "dataViewMappings": [
        {
            "conditions": [
                {
                    "mainValue": {
                        "max": 1
                    },
                    "deltaValue": {
                        "max": 1
                    },
                    "subtitle": {
                        "max": 1
                    },
                    "filterField": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "filterField"
                    },
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 1
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "mainValue"
                            }
                        },
                        {
                            "bind": {
                                "to": "deltaValue"
                            }
                        },
                        {
                            "bind": {
                                "to": "subtitle"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        }
    },
    "supportsKeyboardFocus": true,
    "supportsMultiVisualSelection": true,
    "supportsHighlight": true,
    "supportsLandingPage": true,
    "privileges": []
